# ─── PLINY COMMAND — environment template ────────────────────────────────────
# Copy this file to .env (in the repo root) and fill in whichever provider
# keys you want to use. server.py auto-loads .env at startup (existing shell
# variables win), so on Windows a bare `start-windows.cmd` picks it up too.
# `make run` / quickstart.sh still source it themselves beforehand.
#
# All keys are optional. The gauntlet only attempts targets whose key is set.
# Hermes-4-405B is used as both the JUDGE and the FALLBACK ATTACKER, so
# OPENROUTER_API_KEY is the most important one - without it the gauntlet has
# no judge and no escape hatch when Claude attackers get filtered.

# ─── REQUIRED for the judge + Hermes attacker fallback ──────────────────────
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Per-provider native keys (each one optional) ───────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
XAI_API_KEY=xai-...
DEEPSEEK_API_KEY=sk-...
MISTRAL_API_KEY=...
DASHSCOPE_API_KEY=sk-...   # Qwen (Alibaba DashScope)

# ─── Optional: claude CLI for the anthropic provider in rt_send.py ──────────
# If you want to target Claude models via the local `claude` CLI sandbox
# (rather than the Anthropic native API), install Claude Code first:
#   https://docs.claude.com/en/docs/claude-code

# ─── Workspace paths (optional, sane defaults) ──────────────────────────────
# PLINY_HOME      where the installed repo lives (server.py + HTML).
#                 Defaults to the repo dir; only override for symlink installs.
# PLINY_WORKSHOP  where agents write artifacts, memory, the village repo,
#                 dragonfire, shipping logs. Defaults to <repo>/state/workshop;
#                 everything stays inside this checkout.
# PLINY_HOME=/path/to/pliny-command
# PLINY_WORKSHOP=/path/to/workshop

# ─── Optional: P4RS3LT0NGV3 sidecar (222 transforms) ────────────────────────
# The sidecar is a separate checkout, cloned by:
#   python p4rs3lt0ngv3_bridge.py sync
# Default location is <repo>/organs/p4rs3lt0ngv3. Set the override only if
# you keep the checkout somewhere else. PLINY_P4RS_DISABLE=1 forces the
# native 94-technique registry even when the checkout exists.
# PLINY_P4RS3LT0NGV3_DIR=C:\path\to\P4RS3LT0NGV3
# PLINY_P4RS_DISABLE=0
# PLINY_P4RS_NODE_TIMEOUT=30

# ─── Optional: dashboard auth ───────────────────────────────────────────────
# Set this to require a Bearer token on /api/* endpoints. Recommended if
# you're binding to a non-loopback interface or running behind a tunnel.
# Agents receive a separate scoped token; PLINY_AUTH_TOKEN never enters their
# environment.
# PLINY_AUTH_TOKEN=

# ─── Optional: agent permissions ────────────────────────────────────────────
# workshop (default): no blanket permission bypass; Claude Code runs in auto
#   permission mode, OpenCode is confined to the workshop + temp directories.
# unrestricted: historical behaviour (--dangerously-skip-permissions,
#   OpenCode --auto). Only on a trusted machine.
# PLINY_AGENT_PERMISSIONS=workshop

# ─── Optional: bind address (defaults to 127.0.0.1) ────────────────────────
# PLINY_BIND_HOST=127.0.0.1

# Computer Use frame size: the screenshot an agent sees, in pixels. The
# default (1280x800) keeps image tokens down; raise it when the target UI is
# dense (CAD ribbons, trading terminals) and labels stop being legible. A zoom
# on demand is cheaper than a permanently larger frame: agents can crop any
# region at native resolution.
# PLINY_CU_FRAME_SIZE=1280x800
